---
import type { Project } from "../data/projects";

interface Props {
    projects: Project[];
    detailed?: boolean;
}

const { projects, detailed = false } = Astro.props;
const Heading = detailed ? "h2" : "h3";
---

<div class="flex flex-col">
    {
        projects.map((project, index) => (
            <article
                class:list={[
                    "border-border first:border-t-0 first:pt-0",
                    index > 0 && "border-t",
                    detailed ? "py-6" : "py-5",
                ]}
            >
                <div class="flex items-start justify-between gap-4">
                    <div class="min-w-0">
                        <Heading
                            class:list={[
                                "text-charcoal",
                                detailed
                                    ? "text-lg font-semibold"
                                    : "text-[0.9375rem] font-medium",
                            ]}
                        >
                            <a
                                href={project.href}
                                target="_blank"
                                rel="noopener noreferrer"
                                class="transition-colors duration-150"
                            >
                                {project.title}
                            </a>
                        </Heading>

                        <p class="mt-1 text-sm text-muted leading-relaxed">
                            {project.description}
                        </p>
                    </div>

                    <a
                        href={project.href}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="mt-0.5 shrink-0 inline-flex items-center justify-center w-8 h-8 rounded-md border border-border text-muted transition-all duration-200 hover:text-charcoal hover:border-border-hover hover:bg-pill-bg hover:-translate-y-px"
                        aria-label={`${project.title} on GitHub`}
                        title="GitHub"
                    >
                        <svg
                            class="w-4 h-4"
                            viewBox="0 0 24 24"
                            fill="currentColor"
                        >
                            <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z" />
                        </svg>
                    </a>
                </div>

                {
                    detailed && (
                        <ul class="mt-3 flex flex-col gap-1.5">
                            {project.highlights.map((highlight) => (
                                <li class="flex gap-2 text-sm leading-relaxed text-[#3a3a3a]">
                                    <span class="mt-[0.5rem] h-1 w-1 shrink-0 rounded-full bg-light" />
                                    <span>{highlight}</span>
                                </li>
                            ))}
                        </ul>
                    )
                }

                <div class="mt-3 flex flex-wrap gap-1.5">
                    {project.tech.map((tech) => (
                        <span class="text-xs px-2 py-1 rounded-full bg-pill-bg text-muted">
                            {tech}
                        </span>
                    ))}
                </div>
            </article>
        ))
    }
</div>
